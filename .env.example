# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mercury_db
POSTGRES_PORT=5432

# Application Connection URLs (for Docker or local run)
# For Docker Compose, the host is 'postgres'
# For Local Run, the host is 'localhost'
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/mercury_db

# Microservice Endpoints
PORT=5000
ML_PORT=8000
ML_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000


# PostgreSQL Administrator / Migration Credentials (Container Setup Only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=mercury_db
POSTGRES_PORT=5432

# Dedicated Least-Privilege Application Users (SEC-12)
APP_DB_USER=mercury_app
APP_DB_PASSWORD=mercury_app_secret
ML_DB_USER=mercury_ml
ML_DB_PASSWORD=mercury_ml_secret

# Application Connection URLs (for Docker or local run)
# Express Gateway connects as least-privilege mercury_app:
DATABASE_URL=postgresql://mercury_app:mercury_app_secret@localhost:5432/mercury_db

# Microservice Endpoints
PORT=5000
ML_PORT=8000
ML_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000

